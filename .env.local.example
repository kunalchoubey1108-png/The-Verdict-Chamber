# VerdictPay environment variables.
# Copy to .env.local. All integrations are optional; fallback data is available.

# Google Gemini AI — powers the multi-agent jury
# Get key at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Optional: override the AI model (defaults to gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# PayPal REST app — SANDBOX credentials only (never live keys)
# Create at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# Signs jury verdicts so payments can only be created for approved amounts.
# Generate with: openssl rand -hex 32
VERDICT_SIGNING_SECRET=replace_with_random_hex_string
