# ── The Verdict Chamber — Environment Variables ──────────────────────────────
# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored and never committed.

# Google Gemini AI — powers the multi-agent jury
# Get key at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Finnhub — real-time NSE/BSE equity prices
# Get free key at: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# Optional: override the AI model (defaults to gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Optional: enable demo mode (uses mock evidence, no real API calls)
# NEXT_PUBLIC_DEMO_MODE=true
